<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_add_payment"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <!-- 1. Customer Selection (Dropdown) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCustomer"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:hint="@string/select_customer"
            app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/card_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/card_corner_radius">

            <AutoCompleteTextView
                android:id="@+id/actvCustomer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:inputType="none"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. Optional Work Link Selection (Dropdown) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWorkEntry"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:hint="@string/label_link_work_optional"
            app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/card_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/card_corner_radius">

            <AutoCompleteTextView
                android:id="@+id/actvWorkEntry"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:inputType="none"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. Amount (in ₹) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAmount"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:hint="@string/label_amount"
            app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/card_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/card_corner_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 4. Payment Method Selection (Dropdown) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPaymentMethod"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:hint="@string/label_payment_method"
            app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/card_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/card_corner_radius">

            <AutoCompleteTextView
                android:id="@+id/actvPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:inputType="none"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 5. Payment Date -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPaymentDate"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:hint="@string/label_payment_date"
            app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/card_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/card_corner_radius"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPaymentDate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:clickable="true"
                android:focusable="false"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 6. Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNotes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:hint="@string/label_notes"
            app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/card_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/card_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/card_corner_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 7. Save Payment Button (Min 56dp height) -->
        <TextView
            android:id="@+id/tvSaveError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:accessibilityLiveRegion="polite"
            android:text="@string/save_failed"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePayment"
            style="@style/Widget.FarmerAccounts.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_save_payment"
            android:textColor="@color/on_primary" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
