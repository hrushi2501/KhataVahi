<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ledgerScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <!-- Customer Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <!-- Top: Name & Edit button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCustomerName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_headline"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditCustomer"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_edit"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_secondary" />

                    </LinearLayout>

                    <!-- Nickname / Father / Village -->
                    <TextView
                        android:id="@+id/tvCustomerInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <!-- Phone & Call Action -->
                    <LinearLayout
                        android:id="@+id/layoutPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCall"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/btn_call"
                            android:textColor="@color/primary"
                            app:icon="@drawable/ic_phone"
                            app:iconTint="@color/primary" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:background="@color/divider" />

                    <!-- Balance Summary Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ledger_work_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_caption" />

                            <TextView
                                android:id="@+id/tvTotalWork"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ledger_paid_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_caption" />

                            <TextView
                                android:id="@+id/tvTotalPaid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Net Outstanding Due / Advance Banner -->
                    <LinearLayout
                        android:id="@+id/layoutBalanceBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="@color/status_chip_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_small">

                        <TextView
                            android:id="@+id/tvBalanceTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_due"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNetBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_headline"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- WhatsApp Share Button (Min 56dp height) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareWhatsApp"
                style="@style/Widget.FarmerAccounts.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:backgroundTint="@color/income_green"
                android:text="@string/btn_share_hisab"
                android:textColor="@color/on_primary"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_small"
                app:iconTint="@color/on_primary" />

            <!-- Action Buttons for Customer: Add Work & Add Payment -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddWorkForCustomer"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_micro"
                    android:layout_weight="1"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/action_add_work"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_secondary"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/card_corner_radius"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPaymentForCustomer"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_micro"
                    android:layout_weight="1"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/action_add_payment"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_secondary"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/card_corner_radius"
                    app:icon="@drawable/ic_payment"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteCustomer"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/delete_customer"
                android:textColor="@color/expense_red" android:textSize="18sp" />

            <!-- Ledger History Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/ledger_history"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

            <!-- Empty Ledger State -->
            <TextView
                android:id="@+id/tvEmptyLedger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:padding="@dimen/spacing_large"
                android:text="@string/empty_ledger"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body"
                android:visibility="gone" />

            <!-- Chronological Ledger List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLedger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutLedgerStatus"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <include android:id="@+id/skeletonLoading" layout="@layout/layout_loading_skeleton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />



        <TextView
            android:id="@+id/tvLedgerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/ledger_loading"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryLedger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/btn_retry"
            android:textSize="@dimen/text_size_body"
            android:visibility="gone" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

